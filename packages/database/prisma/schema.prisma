datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model SavedPrompt {
  id              String   @id @default(uuid())
  originalPrompt  String
  optimizedPrompt String
  intentSummary   String?
  score           Int
  createdAt       DateTime @default(now())
}
