{
  "name": "prompt-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Prompt Intelligence Engineering Workspace - Modular Monolith Monorepo",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "bin": {
    "piew": "./bin/piew.js",
    "piew-mcp": "./bin/piew-mcp.js"
  },
  "scripts": {
    "pretypecheck": "node scripts/patch-db-dist.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "postbuild": "node scripts/patch-db-dist.mjs",
    "test:adapter": "npx tsx packages/prompt-engine/scripts/test-adapter.ts",
    "test:harness": "npx tsx packages/prompt-engine/scripts/test-harness.ts",
    "test:contracts": "npx tsx packages/prompt-contracts/scripts/test-contracts-v2.ts",
    "test:crawler": "npx tsx packages/prompt-crawler/scripts/test-crawler.ts",
    "pretest:spider": "node scripts/patch-db-dist.mjs",
    "test:spider": "npx tsx packages/prompt-spider/scripts/test-spider.ts",
    "test:closed-loop": "npx tsx packages/prompt-engine/scripts/test-closed-loop.ts",
    "test:master-synthesis": "npx tsx packages/prompt-engine/scripts/test-master-synthesis.ts",
    "test:engine-v2-2": "npx tsx packages/prompt-engine/scripts/test-engine-v2-2.ts",
    "piew": "npx tsx scripts/piew-cli.ts",
    "mcp:start": "npx tsx scripts/piew-mcp-server.ts",
    "mcp:sse": "npx tsx scripts/piew-mcp-server.ts --sse",
    "test:open-source": "npx tsx packages/prompt-engine/scripts/test-open-source-readiness.ts",
    "test:universal-blueprint": "npx tsx packages/prompt-engine/scripts/test-universal-blueprint.ts",
    "test:supervisor": "npx tsx packages/prompt-engine/scripts/test-autonomous-supervisor.ts",
    "test:providers": "npx tsx packages/provider-adapters/scripts/test-provider-registry.ts",
    "pretest:v2-engines": "node scripts/patch-db-dist.mjs",
    "test:v2-engines": "npm run test:contracts && npm run test:crawler && npm run test:spider && npm run test:closed-loop",
    "test:multiplatform": "node scripts/verify-multiplatform.mjs",
    "db:backup": "npx tsx packages/database/scripts/backup-db.ts",
    "db:restore": "npx tsx packages/database/scripts/restore-db.ts",
    "clean": "rm -rf node_modules apps/*/node_modules packages/*/node_modules"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
