{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@prompt-workspace/database": ["../../packages/database/dist/index"],
      "@prompt-workspace/prompt-engine": ["../../packages/prompt-engine/dist/index"],
      "@prompt-workspace/provider-adapters": ["../../packages/provider-adapters/dist/index"],
      "@prompt-workspace/prompt-contracts": ["../../packages/prompt-contracts/dist/index"],
      "@prompt-workspace/prompt-crawler": ["../../packages/prompt-crawler/dist/index"],
      "@prompt-workspace/prompt-spider": ["../../packages/prompt-spider/dist/index"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
